# Copy to backend/.env  (cp .env.example backend/.env)

# Tech Sphere G3 — solo familias permitidas (nivel gratuito / local):
#   groq   → Meta Llama vía Groq Cloud   (recomendado por latencia de voz)
#   gemini → Google Gemini Flash         (ventana de contexto grande)
#   mock   → sin API key (desarrollo offline)
# Anthropic/Claude NO está permitido (descalifica).
#
# Paso 1 del plan: deja groq + pega tu key. Luego: make smoke-groq
LLM_PROVIDER=groq
MODEL_ID=llama-3.3-70b-versatile

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Gemini Flash: https://aistudio.google.com/
# Ejemplo MODEL_ID: gemini-2.0-flash
GEMINI_API_KEY=

# App (puerto del Makefile: 8001)
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data
