# Copy to backend/.env  (cp .env.example backend/.env)

# Challenge-allowed LLM families (free cloud or local only):
#   groq   → Meta Llama via Groq Cloud   (recommended for voice latency)
#   gemini → Google Gemini Flash         (large context window)
#   mock   → no API key (offline development)
# Anthropic/Claude is not allowed.
#
# Step 1: set groq + paste your key, then run: make smoke-groq
LLM_PROVIDER=gemini
# Primary Flash model. If that model's free quota is gone (or the id is retired),
# the backend walks: 3.6-flash → 3.5-flash → 3.5-flash-lite → 3.1-flash-lite,
# then the local mock. Alarm turns never call Gemini.
MODEL_ID=gemini-3.6-flash

# Groq: https://console.groq.com/keys  (Llama 3.3 ya no está en plan gratis)
GROQ_API_KEY=

# Gemini Flash: https://aistudio.google.com/apikey
# Paste the key in backend/.env, not in this file (this file is public on GitHub).
GEMINI_API_KEY=

# App (Makefile uses port 8001)
CORS_ORIGINS=http://localhost:5173
DATA_DIR=./data

# RAG embeddings: fastembed (default, multilingual MiniLM) | hash (offline rollback / fast tests)
EMBED_PROVIDER=fastembed

# TTS: auto (expose Kokoro/Piper when warmed) | kokoro | piper | browser
# UI default remains Web Speech (fast). Server engines are opt-in in Ajustes de voz.
# Requires Python ≥3.10 + `make warm-kokoro` / `make warm-piper`.
TTS_PROVIDER=auto
KOKORO_VOICE=ef_dora
KOKORO_SPEED=1.0
PIPER_VOICE=es_MX-ald-medium
PIPER_SPEED=1.0
